{
  "name": "playwright-thumbnail-service",
  "version": "1.0.0",
  "description": "TSX component to PNG thumbnail service using Playwright",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && npm run build:css",
    "build:css": "tailwindcss -i ./src/styles.css -o ./public/styles.css --minify",
    "start": "node dist/server.js",
    "docker:build": "docker build -t playwright-thumbnail-service .",
    "docker:run": "docker run -p 3000:3000 playwright-thumbnail-service",
    "test": "tsx src/test.ts",
    "test:ssr": "tsx src/test-ssr.ts"
  },
  "keywords": [
    "playwright",
    "thumbnail",
    "react",
    "tsx",
    "screenshot"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@vitejs/plugin-react": "^4.6.0",
    "express": "^4.18.2",
    "playwright": "1.64.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^7.0.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/node-fetch": "^2.6.9",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.17",
    "node-fetch": "^3.3.2",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
